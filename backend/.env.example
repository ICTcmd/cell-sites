# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/cellsite_db
DATABASE_ASYNC_URL=postgresql+asyncpg://postgres:password@localhost:5432/cellsite_db

# API Keys (optional - for external data sources)
OPENCELLID_API_KEY=your_opencellid_api_key_here
CELLMAPPER_API_KEY=your_cellmapper_api_key_here

# Application Settings
APP_NAME=Cell Site Mapping System
DEBUG=True
API_VERSION=v1

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# City Bounding Box (for filtering)
CITY_NAME=Manila
COUNTRY=Philippines
BBOX_MIN_LAT=14.40
BBOX_MAX_LAT=14.80
BBOX_MIN_LON=120.90
BBOX_MAX_LON=121.15

# Triangulation Parameters
MIN_SAMPLES_FOR_TRIANGULATION=5
MAX_DISTANCE_FROM_TOWER_METERS=5000
RSRP_WEIGHT_EXPONENT=2.5
